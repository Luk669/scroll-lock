{
  "name": "scroll-lock",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:youtube": "cross-env APP_VARIANT=youtube expo start",
    "start:instagram": "cross-env APP_VARIANT=instagram expo start",
    "start:facebook": "cross-env APP_VARIANT=facebook expo start",
    "build:youtube": "eas build --profile youtube",
    "build:instagram": "eas build --profile instagram",
    "build:facebook": "eas build --profile facebook",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.5.1",
    "@types/react": "~18.2.79",
    "babel-preset-expo": "~11.0.0",
    "cross-env": "^7.0.3",
    "typescript": "~5.3.3"
  }
}
